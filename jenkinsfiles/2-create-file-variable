pipeline {
    agent any
    
    parameters {
        string(name: 'FOLDER_NAME', defaultValue: "${JOB_BASE_NAME}")
        string(name: 'FILE_NAME')
        string(name: 'FILE_CONTENT')
    }

    stages {
        stage('Create Object With Variable') {
            steps {
                script {
                    if (!params.FOLDER_NAME || !params.FILE_NAME) {
                        error "폴더명과 파일명은 비워둘 수 없습니다."
                    }
                }
                writeFile encoding: 'UTF-8', 
                          file: "${params.FOLDER_NAME}/${params.FILE_NAME}", 
                          text: params.FILE_CONTENT
            }
        }
            
        stage('Copy to Server') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ssh-key-tedworks', keyFileVariable: 'SSH_KEY_FILE', usernameVariable: 'SSH_USER')]) {
                    sh '''
                        scp -r -i "$SSH_KEY_FILE" \
                            -o StrictHostKeyChecking=no \
                            "${WORKSPACE}/${FOLDER_NAME}" \
                            "$SSH_USER@172.30.1.77:${TEDWORKS_HOME}/artifacts/data/"
                    '''
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
    }
}
